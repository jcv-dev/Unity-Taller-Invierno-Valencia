# -----------------------------------------
# Unity generated / non-versionable folders
# -----------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore Asset meta data (asset references break without them)
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code generated files
/[Aa]ssets/Plugins/Editor/JetBrains*
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Temporary / scratch files
.scratch/
.DS_Store
Thumbs.db

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
consulo/
*.tmp
*.svd
*.user

# Asset Store Tools
[}Aa]ssetStoreTools*
